# Copy to .env and fill in. .env is gitignored — never commit real tokens.
#
# Fine-grained PAT scoped to the SANDBOX repo used by live integration tests.
# Required scopes: Contents: Read/Write, Issues: Read/Write, Administration: Read/Write.
SHADOWTEST_PAT=

# Sandbox repo in owner/name form, e.g. JaredCH/shadow720-sandbox
SHADOWTEST_REPO=

# Set to 1 to allow live tests that delete repository resources.
# Leave unset/0 for normal runs.
SHADOWTEST_ALLOW_DESTRUCTIVE=0

# Base URL override (defaults to https://api.github.com)
SHADOWTEST_API_BASE=