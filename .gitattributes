# Shell scripts must keep LF endings or the shebang breaks on Linux.
*.sh text eol=lf

# Windows scripts and project files keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts must never be line-ending converted.
*.png binary
*.ico binary
*.jks binary
*.apk binary
*.exe binary
*.msi binary
*.deb binary
*.rpm binary
*.AppImage binary
